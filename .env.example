# Copy to .env and fill in values before running the stack.
# Keep secrets out of version control.
DOMAIN=:80
WEBUI_SECRET_KEY=
DEPLOY_HOST=
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=
OPENWEBUI_DB_NAME=openwebui
OPENWEBUI_DB_USER=openwebui
OPENWEBUI_DB_PASSWORD=
# Leave both database URLs empty for local PostgreSQL.
# For RDS, copy these URL templates into .env, replace endpoint/password, and
# URL-encode any special characters in passwords:
OPENWEBUI_DATABASE_URL=
# OPENWEBUI_DATABASE_URL=postgresql://openwebui:URL_ENCODED_PASSWORD@RDS_ENDPOINT:5432/openwebui?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-global-bundle.pem
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=
LITELLM_DATABASE_URL=
# LITELLM_DATABASE_URL=postgresql://litellm:URL_ENCODED_PASSWORD@RDS_ENDPOINT:5432/litellm?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-global-bundle.pem
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ROUTER_API_KEY=
